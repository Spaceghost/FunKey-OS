#!/bin/sh
set -u

DAEMON=${FUNKEY_IROH_BIN:-/usr/bin/funkey-iroh}
LIBRARY_TOOL=${FUNKEY_IROH_LIBRARY_TOOL:-/usr/bin/funkey-iroh-library}
INIT=${FUNKEY_IROH_INIT:-/etc/init.d/S44funkey-iroh}
SYNC_INIT=${FUNKEY_IROH_SYNC_INIT:-/etc/init.d/S45funkey-iroh-sync}
CONFIG=${FUNKEY_IROH_CONFIG:-/etc/default/funkey-iroh}
COMMON=${FUNKEY_IROH_COMMON:-/usr/lib/funkey-iroh/common.sh}

[ -r "$CONFIG" ] && . "$CONFIG"
[ -r "$COMMON" ] && . "$COMMON"

FUNKEY_IROH_STATE_DIR=${FUNKEY_IROH_STATE_DIR:-/mnt/.funkey-iroh}
FUNKEY_IROH_INBOX=${FUNKEY_IROH_INBOX:-$FUNKEY_IROH_STATE_DIR/inbox}
FUNKEY_IROH_BUNDLE_INBOX=${FUNKEY_IROH_BUNDLE_INBOX:-$FUNKEY_IROH_STATE_DIR/bundle-inbox}
FUNKEY_IROH_LIBRARY=${FUNKEY_IROH_LIBRARY:-/mnt/FunKey/Shared Games}
FUNKEY_IROH_RUNTIME_DIR=${FUNKEY_IROH_RUNTIME_DIR:-/var/run/funkey-iroh}
FUNKEY_IROH_ENDPOINT_LOCK=${FUNKEY_IROH_ENDPOINT_LOCK:-/var/lock/funkey-iroh-endpoint.lock}
FUNKEY_IROH_EXCLUSIVE=${FUNKEY_IROH_EXCLUSIVE:-$FUNKEY_IROH_RUNTIME_DIR/exclusive}
ENABLE_FILE=$FUNKEY_IROH_STATE_DIR/enabled
TICKET_FILE=$FUNKEY_IROH_STATE_DIR/current-ticket
LOG_FILE=$FUNKEY_IROH_STATE_DIR/service.log
USB_NETWORK_MARKER=/mnt/usbnet
PROMPT_FILE=$FUNKEY_IROH_STATE_DIR/launch-prompt
UI_INITIALIZED=$FUNKEY_IROH_STATE_DIR/ui-initialized
UI_OPK_SOURCE=${FUNKEY_IROH_UI_OPK_SOURCE:-/usr/local/share/OPKs/Settings/iroh_funkey-s.opk}
UI_OPK_TARGET=${FUNKEY_IROH_UI_OPK_TARGET:-/mnt/Settings/iroh_funkey-s.opk}

export FUNKEY_IROH_STATE_DIR
export FUNKEY_IROH_INBOX
export FUNKEY_IROH_BUNDLE_INBOX
export FUNKEY_IROH_LIBRARY
export FUNKEY_IROH_MAX_SAVE_BYTES=${FUNKEY_IROH_MAX_SAVE_BYTES:-67108864}
export FUNKEY_IROH_MAX_BUNDLE_BYTES=${FUNKEY_IROH_MAX_BUNDLE_BYTES:-17179869184}
export FUNKEY_IROH_MAX_BUNDLE_FILES=${FUNKEY_IROH_MAX_BUNDLE_FILES:-4096}
export FUNKEY_IROH_MAX_INCOMING_CONNECTIONS=${FUNKEY_IROH_MAX_INCOMING_CONNECTIONS:-4}
export FUNKEY_IROH_HANDSHAKE_TIMEOUT=${FUNKEY_IROH_HANDSHAKE_TIMEOUT:-15}
export FUNKEY_IROH_ONLINE_TIMEOUT=${FUNKEY_IROH_ONLINE_TIMEOUT:-8}

install_one_opk()
{
    source=$1
    target=$2
    [ -r "$source" ] || return 0
    mkdir -p "$(dirname "$target")"
    if [ -r "$target" ] && cmp -s "$source" "$target"; then
        return 0
    fi
    temporary="${target}.tmp.$$"
    cp "$source" "$temporary" || {
        rm -f "$temporary"
        return 1
    }
    sync "$temporary" 2>/dev/null || sync
    mv "$temporary" "$target"
}

install_ui()
{
    grep -q '[[:space:]]/mnt[[:space:]]' /proc/mounts 2>/dev/null || return 0

    install_one_opk "$UI_OPK_SOURCE" "$UI_OPK_TARGET" || return 1
    for source in /usr/local/share/OPKs/Libretro/*_picoarch_funkey-s.opk; do
        [ -r "$source" ] || continue
        install_one_opk "$source" "/mnt/Libretro/$(basename "$source")" || return 1
    done
}

acquire_endpoint_lock()
{
    mkdir -p "$(dirname "$FUNKEY_IROH_ENDPOINT_LOCK")" "$FUNKEY_IROH_RUNTIME_DIR"
    attempts=0
    while ! mkdir "$FUNKEY_IROH_ENDPOINT_LOCK" 2>/dev/null; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 30 ]; then
            echo "funkey-iroh-service: another endpoint command holds $FUNKEY_IROH_ENDPOINT_LOCK" >&2
            return 75
        fi
        sleep 1
    done
    : > "$FUNKEY_IROH_EXCLUSIVE"
}

release_endpoint_lock()
{
    rm -f "$FUNKEY_IROH_EXCLUSIVE"
    rmdir "$FUNKEY_IROH_ENDPOINT_LOCK" 2>/dev/null || :
}

with_endpoint()
{
    acquire_endpoint_lock || return $?
    was_running=0
    if "$INIT" status >/dev/null 2>&1; then
        was_running=1
        "$INIT" stop || {
            status=$?
            release_endpoint_lock
            return "$status"
        }
    fi

    interrupted=0
    endpoint_pid=
    "$DAEMON" "$@" &
    endpoint_pid=$!
    trap 'interrupted=1; kill -TERM "$endpoint_pid" 2>/dev/null || :' INT TERM HUP
    wait "$endpoint_pid"
    command_status=$?
    trap - INT TERM HUP
    endpoint_pid=

    release_endpoint_lock
    if [ "$was_running" -eq 1 ]; then
        "$INIT" start || {
            restart_status=$?
            echo "funkey-iroh-service: command exited $command_status and receiver restart exited $restart_status" >&2
            return "$restart_status"
        }
    fi
    [ "$interrupted" -eq 0 ] || return 130
    return "$command_status"
}

print_running_ticket()
{
    attempts=0
    while [ ! -s "$TICKET_FILE" ]; do
        if ! "$INIT" status >/dev/null 2>&1; then
            echo "funkey-iroh-service: receiver stopped before publishing a ticket" >&2
            return 1
        fi
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 15 ]; then
            echo "funkey-iroh-service: receiver did not publish a fresh ticket" >&2
            return 1
        fi
        sleep 1
    done
    cat "$TICKET_FILE"
    printf '\n'
}

enable_service()
{
    mkdir -p "$FUNKEY_IROH_STATE_DIR" "$FUNKEY_IROH_INBOX" "$FUNKEY_IROH_BUNDLE_INBOX" "$FUNKEY_IROH_LIBRARY"
    : > "$ENABLE_FILE"

    if [ ! -e "$UI_INITIALIZED" ]; then
        : > "$PROMPT_FILE"
        : > "$UI_INITIALIZED"
    fi

    if [ ! -e "$USB_NETWORK_MARKER" ]; then
        : > "$USB_NETWORK_MARKER"
        echo "funkey-iroh-service: enabled persistent USB networking; reconnect or reboot if usb0 is not present" >&2
    fi

    install_ui || echo "funkey-iroh-service: could not install launcher UI OPK" >&2
    "$INIT" start || return $?
    [ -x "$SYNC_INIT" ] && "$SYNC_INIT" start || :
}

disable_service()
{
    [ -x "$SYNC_INIT" ] && "$SYNC_INIT" stop || :
    "$INIT" stop || return $?
    rm -f "$ENABLE_FILE"
}

case "${1:-}" in
    enable)
        enable_service
        ;;
    disable)
        disable_service
        ;;
    start)
        "$INIT" start
        [ -x "$SYNC_INIT" ] && "$SYNC_INIT" start || :
        ;;
    stop)
        [ -x "$SYNC_INIT" ] && "$SYNC_INIT" stop || :
        exec "$INIT" stop
        ;;
    restart)
        [ -x "$SYNC_INIT" ] && "$SYNC_INIT" stop || :
        "$INIT" restart || exit $?
        [ -x "$SYNC_INIT" ] && "$SYNC_INIT" start || :
        ;;
    status)
        receiver_status=0
        "$INIT" status || receiver_status=$?
        if [ -x "$SYNC_INIT" ]; then
            "$SYNC_INIT" status || :
        fi
        exit "$receiver_status"
        ;;
    install-ui)
        install_ui
        ;;
    ticket)
        if "$INIT" status >/dev/null 2>&1; then
            print_running_ticket
        else
            with_endpoint ticket
        fi
        ;;
    peer|peers|id|version|help|--help|-h|--version|-V)
        exec "$DAEMON" "$@"
        ;;
    send)
        shift
        with_endpoint save send "$@"
        ;;
    bundle)
        shift
        case "${1:-}" in
            send|push)
                with_endpoint bundle "$@"
                ;;
            inspect|verify)
                exec "$DAEMON" bundle "$@"
                ;;
            *)
                echo "Usage: $0 bundle {send|inspect} ..." >&2
                exit 64
                ;;
        esac
        ;;
    netplay)
        shift
        with_endpoint netplay "$@"
        ;;
    library)
        shift
        exec "$LIBRARY_TOOL" "$@"
        ;;
    run)
        shift
        [ "$#" -gt 0 ] || {
            echo "Usage: $0 run FUNKEY_IROH_ARGUMENT..." >&2
            exit 64
        }
        with_endpoint "$@"
        ;;
    pairing)
        shift
        exec /usr/bin/funkey-iroh-pairing "$@"
        ;;
    sync)
        shift
        exec /usr/bin/funkey-iroh-sync-peer "$@"
        ;;
    inbox)
        shift
        if [ "$#" -gt 0 ]; then
            exec /usr/bin/funkey-iroh-inbox "$@"
        fi
        {
            /usr/bin/funkey-iroh-inbox list 2>/dev/null
            find "$FUNKEY_IROH_BUNDLE_INBOX" -type d -name '*.funkey' 2>/dev/null
        } | sort
        ;;
    session)
        shift
        exec /usr/bin/funkey-iroh-session "$@"
        ;;
    ui)
        shift
        exec /usr/bin/funkey-iroh-ui "$@"
        ;;
    logs)
        lines=${2:-100}
        case "$lines" in
            ''|*[!0-9]*) echo "lines must be an integer" >&2; exit 64 ;;
        esac
        tail -n "$lines" "$LOG_FILE"
        ;;
    *)
        cat >&2 <<EOF
Usage: $0 COMMAND [ARGS]

Commands:
  enable|disable                 Enable or disable receiver and sync worker
  start|stop|restart|status      Control both services
  install-ui                     Install/update the Settings launcher OPK
  ticket                         Print the current pairing ticket
  peer add|list|remove ...       Manage paired endpoint identities
  pairing export|import ...      Exchange USB-friendly pairing cards
  sync list|toggle ...           Configure automatic post-game save peers
  inbox [list|install|archive]   Review received saves and bundles safely
  session list|status|stop       Inspect multiplayer adapters and session
  send PEER SYSTEM GAME FILE     Send a save, pausing the receiver safely
  bundle send PEER BUNDLE        Send a complete portable game bundle
  bundle inspect BUNDLE          Verify and list a local portable bundle
  library COMMAND ...            Adopt, refresh, send, or install games
  netplay host|join ...          Run a UDP tunnel, pausing the receiver safely
  run ARGS...                    Run another endpoint command safely
  ui [ARGS...]                   Open the on-device Iroh UI
  logs [LINES]                   Show receiver logs
EOF
        exit 64
        ;;
esac
