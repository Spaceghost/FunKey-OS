#!/bin/sh

# Select a firmware update without splitting filenames or guessing which of
# several updates the user intended to install.
find_firmware_update()
{
    FIRMWARE_UPDATE_FILE=

    set -- "${1:-/mnt}"/FunKey-*.fwu
    if [ "$#" -eq 1 ] && [ ! -f "$1" ]; then
        return 1
    fi
    if [ "$#" -ne 1 ]; then
        return 2
    fi

    FIRMWARE_UPDATE_FILE=$1
    return 0
}

# Validate the complete archive before allowing SWUpdate to stream anything to
# the root partition. The normal install pass repeats these checks while it
# writes, but discovering a damaged archive there would be too late.
install_firmware_update()
{
    swupdate -c -i "$1" || return 1
    swupdate -i "$1"
}
