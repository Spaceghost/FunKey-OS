#!/usr/bin/env python3
"""Render Buildroot show-info JSON as a stable on-device package list."""

import json
import sys


if len(sys.argv) != 3:
    raise SystemExit(f"usage: {sys.argv[0]} INPUT.json OUTPUT.txt")

source, destination = sys.argv[1:]
with open(source, encoding="utf-8") as stream:
    packages = json.load(stream)

installed = []
for name, details in packages.items():
    if details.get("type") != "target" or not details.get("install_target"):
        continue
    if details.get("virtual"):
        continue
    installed.append(
        (
            name,
            str(details.get("version", "unknown")),
            str(details.get("licenses", "unknown")),
        )
    )

with open(destination, "w", encoding="utf-8", newline="\n") as stream:
    stream.write("PACKAGE\tVERSION\tLICENSE\n")
    for row in sorted(installed, key=lambda item: item[0].casefold()):
        stream.write("\t".join(field.replace("\t", " ") for field in row) + "\n")
