find_host_tool()
{
    local name=$1
    local candidate
    for candidate in \
        "$host_root/bin/$name" \
        "$host_root/usr/bin/$name" \
        "$host_bin/$name"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

mksquashfs_bin=${MKSQUASHFS:-$(find_host_tool mksquashfs)}
unsquashfs_bin=${UNSQUASHFS:-$(find_host_tool unsquashfs)}

