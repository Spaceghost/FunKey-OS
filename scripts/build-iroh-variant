wrap_picoarch_opks()
{
    local source_root="$repo/FunKey/package/picoarch/opk"
    local source_directory system embedded local_opk unpack desktop original patched_opk
    local count=0

    mkdir -p "$backup_dir/opks" "$backup_dir/unpacked"
    for source_directory in "$source_root"/*; do
        [[ -d "$source_directory" ]] || continue
        system=$(basename "$source_directory")
        embedded="/usr/local/share/OPKs/Libretro/${system}_picoarch_funkey-s.opk"
        local_opk="$backup_dir/opks/${system}.opk"
        unpack="$backup_dir/unpacked/$system"
        patched_opk="$backup_dir/opks/${system}.wrapped.opk"

        if ! "$debugfs_bin" -R "dump $embedded $local_opk" "$rootfs" \
            >/dev/null 2>&1; then
            continue
        fi

        rm -rf "$unpack"
        "$unsquashfs_bin" -no-progress -d "$unpack" "$local_opk" >/dev/null
        desktop=$(find "$unpack" -maxdepth 2 -type f -name '*.desktop' -print -quit)
        [[ -n "$desktop" ]] || {
            printf 'no desktop entry found inside %s\n' "$embedded" >&2
            exit 1
        }
        original=$(sed -n 's/^Exec=//p' "$desktop" | head -n 1)
        [[ -n "$original" ]] || {
            printf 'desktop entry has no Exec line: %s\n' "$desktop" >&2
            exit 1
        }

        if ! grep -q 'funkey-iroh-launch' "$desktop"; then
            sed -i \
                "s#^Exec=.*#Exec=/usr/bin/funkey-iroh-launch --system $system -- $original#" \
                "$desktop"
        fi
        if ! grep -q '^X-FunKey-Iroh-System=' "$desktop"; then
            printf 'X-FunKey-Iroh-System=%s\n' "$system" >> "$desktop"
        fi

        rm -f "$patched_opk"
        "$mksquashfs_bin" "$unpack" "$patched_opk" \
            -all-root -noappend -no-exports -no-xattrs >/dev/null

        {
            printf 'rm %s\n' "$embedded"
            printf 'write %s %s\n' "$patched_opk" "$embedded"
        } >> "$commands"
        printf '%s\t%s\t%s\n' \
            "$system" "$embedded" "$(sha256sum "$patched_opk" | awk '{print $1}')" \
            >> "$wrapped_manifest"
        count=$((count + 1))
    done
    printf '%s\n' "$count"
}

wrapped_count=$(wrap_picoarch_opks)

E2FSPROGS_FAKE_TIME="$filesystem_time" \
    "$debugfs_bin" -w -f "$commands" "$rootfs" >"$backup_dir/debugfs.log" 2>&1 || {
        cat "$backup_dir/debugfs.log" >&2
        exit 1
    }

