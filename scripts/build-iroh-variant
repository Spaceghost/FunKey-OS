#!/bin/bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
base_version=${1:?usage: build-iroh-variant VERSION}
variant_version="${base_version}-iroh"
manifest="$repo/tools/funkey-iroh/Cargo.toml"
target=${FUNKEY_IROH_RUST_TARGET:-armv7-unknown-linux-musleabihf}
toolchain=${FUNKEY_IROH_RUST_TOOLCHAIN:-1.91.0}
host_bin=${FUNKEY_IROH_HOST_BIN:-"$repo/FunKey/output/host/bin"}
linker=${FUNKEY_IROH_LINKER:-"$host_bin/arm-linux-gcc"}
archiver=${FUNKEY_IROH_AR:-"$host_bin/arm-linux-ar"}
stripper=${FUNKEY_IROH_STRIP:-"$host_bin/arm-linux-strip"}
debugfs_bin=${DEBUGFS:-"$repo/FunKey/output/host/sbin/debugfs"}
e2fsck_bin=${E2FSCK:-"$repo/FunKey/output/host/sbin/e2fsck"}
readelf_bin=${READELF:-readelf}
filesystem_time=${SOURCE_DATE_EPOCH:-$(git -C "$repo" log -1 --format=%ct)}
rootfs="$repo/FunKey/output/images/rootfs.ext2"
crate_dir="$repo/tools/funkey-iroh"
target_dir=${CARGO_TARGET_DIR:-"$repo/.cargo-target/funkey-iroh"}
binary="$target_dir/$target/release/funkey-iroh"
rootfs_files="$crate_dir/target-rootfs"
backup_dir=$(mktemp -d "$repo/.iroh-variant.XXXXXX")
rootfs_backup="$backup_dir/rootfs.ext2"

restore_rootfs()
{
    if [[ -e "$rootfs_backup" ]]; then
        cp --reflink=auto --sparse=always "$rootfs_backup" "$rootfs"
    fi
    rm -rf "$backup_dir"
}
trap restore_rootfs EXIT

for tool in cargo rustc "$linker" "$archiver" "$debugfs_bin" "$e2fsck_bin" "$readelf_bin"; do
    if [[ "$tool" == */* ]]; then
        [[ -x "$tool" ]] || {
            printf 'required tool is missing or not executable: %s\n' "$tool" >&2
            exit 127
        }
    elif ! command -v "$tool" >/dev/null 2>&1; then
        printf 'required tool is missing from PATH: %s\n' "$tool" >&2
        exit 127
    fi
done

[[ -f "$rootfs" ]] || {
    printf 'completed FunKey rootfs image is missing: %s\n' "$rootfs" >&2
    exit 2
}
[[ "$filesystem_time" =~ ^[0-9]+$ ]] || {
    printf 'invalid filesystem timestamp: %s\n' "$filesystem_time" >&2
    exit 2
}

cargo_command=(cargo)
rustc_command=(rustc)
if command -v rustup >/dev/null 2>&1 && [[ -n "$toolchain" ]]; then
    cargo_command+=("+$toolchain")
    rustc_command+=("+$toolchain")
fi

rust_version=$("${rustc_command[@]}" --version)
case "$rust_version" in
    "rustc 1.91."*) ;;
    *)
        printf 'funkey-iroh requires Rust 1.91.x; selected compiler is: %s\n' "$rust_version" >&2
        exit 2
        ;;
esac

lock_flag=()
if [[ -f "$crate_dir/Cargo.lock" ]]; then
    lock_flag=(--locked)
else
    printf 'warning: Cargo.lock is absent; generating one for this build\n' >&2
fi

mkdir -p "$target_dir"
export CARGO_TARGET_DIR="$target_dir"
export CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_LINKER="$linker"
export CC_armv7_unknown_linux_musleabihf="$linker"
export AR_armv7_unknown_linux_musleabihf="$archiver"
export CFLAGS_armv7_unknown_linux_musleabihf="-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard"
export RUSTFLAGS="${RUSTFLAGS:-} -C target-cpu=cortex-a7 -C target-feature=+neon,+vfp4 -C link-arg=-Wl,--gc-sections"

printf 'building funkey-iroh with %s for %s\n' "$rust_version" "$target"
"${cargo_command[@]}" build \
    --manifest-path "$manifest" \
    --target "$target" \
    --release \
    "${lock_flag[@]}"

[[ -x "$binary" ]] || {
    printf 'cargo did not produce an executable: %s\n' "$binary" >&2
    exit 1
}

if [[ -x "$stripper" ]]; then
    "$stripper" --strip-unneeded "$binary"
fi

if ! file "$binary" | grep -q 'ARM'; then
    file "$binary" >&2
    printf 'funkey-iroh binary is not an ARM executable\n' >&2
    exit 1
fi
if "$readelf_bin" -d "$binary" 2>/dev/null | grep -q '(NEEDED)'; then
    "$readelf_bin" -d "$binary" >&2
    printf 'funkey-iroh must be statically linked; dynamic Rust libraries are not in the firmware\n' >&2
    exit 1
fi

binary_size=$(wc -c < "$binary")
max_binary_size=${FUNKEY_IROH_MAX_BINARY_BYTES:-33554432}
if (( binary_size > max_binary_size )); then
    printf 'funkey-iroh is %d bytes, over the configured %d-byte ceiling\n' \
        "$binary_size" "$max_binary_size" >&2
    exit 1
fi
binary_sha=$(sha256sum "$binary" | awk '{print $1}')

chmod 0755 \
    "$rootfs_files/etc/init.d/S44funkey-iroh" \
    "$rootfs_files/usr/bin/funkey-iroh-service"

cp --reflink=auto --sparse=always "$rootfs" "$rootfs_backup"

commands="$backup_dir/debugfs.commands"
cat > "$commands" <<EOF
write $binary /usr/bin/funkey-iroh
write $rootfs_files/usr/bin/funkey-iroh-service /usr/bin/funkey-iroh-service
write $rootfs_files/etc/init.d/S44funkey-iroh /etc/init.d/S44funkey-iroh
write $rootfs_files/etc/default/funkey-iroh /etc/default/funkey-iroh
EOF

E2FSPROGS_FAKE_TIME="$filesystem_time" \
    "$debugfs_bin" -w -f "$commands" "$rootfs" >"$backup_dir/debugfs.log" 2>&1 || {
        cat "$backup_dir/debugfs.log" >&2
        exit 1
    }

dump_and_compare()
{
    local embedded_path=$1
    local source_path=$2
    local label=$3
    local dump_path="$backup_dir/$label.embedded"

    "$debugfs_bin" -R "dump $embedded_path $dump_path" "$rootfs" >/dev/null 2>&1 || {
        printf 'failed to read injected file %s back from rootfs\n' "$embedded_path" >&2
        exit 1
    }
    cmp "$source_path" "$dump_path"
}

dump_and_compare /usr/bin/funkey-iroh "$binary" binary
dump_and_compare /usr/bin/funkey-iroh-service \
    "$rootfs_files/usr/bin/funkey-iroh-service" service
dump_and_compare /etc/init.d/S44funkey-iroh \
    "$rootfs_files/etc/init.d/S44funkey-iroh" init
dump_and_compare /etc/default/funkey-iroh \
    "$rootfs_files/etc/default/funkey-iroh" config

fsck_status=0
E2FSPROGS_FAKE_TIME="$filesystem_time" E2FSCK_TIME="$filesystem_time" \
    "$e2fsck_bin" -pf "$rootfs" >/dev/null || fsck_status=$?
if (( fsck_status > 1 )); then
    exit "$fsck_status"
fi

make -C "$repo" -j1 package-image package-update package-checksums \
    FUNKEY_VERSION="$variant_version"

metadata="$repo/images/iroh-${variant_version}.json"
cat > "$metadata.tmp" <<EOF
{
  "profile": "iroh",
  "firmware_version": "$variant_version",
  "binary": "/usr/bin/funkey-iroh",
  "binary_bytes": $binary_size,
  "binary_sha256": "$binary_sha",
  "rust_target": "$target",
  "rust_version": "$rust_version",
  "iroh_version": "1.0.3",
  "save_protocol": "funkey/saves/1",
  "netplay_protocol": "funkey/netplay/1"
}
EOF
mv "$metadata.tmp" "$metadata"

(
    cd "$repo/images"
    sha256sum "$(basename "$metadata")" >> "SHA256SUMS-${variant_version}.txt"
)

printf 'created Iroh firmware variant %s\n' "$variant_version"
printf 'binary: %s bytes sha256=%s\n' "$binary_size" "$binary_sha"
