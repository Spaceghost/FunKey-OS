#!/bin/bash
set -eu

driver=cc
language=c
case "$0" in
	*++*|*cxx*) driver=c++; language=c++ ;;
esac

if [ "$#" -eq 1 ] && [ "$1" = "-v" ]; then
	zig "$driver" -v
	printf '%s\n' 'gcc version 9.0.0 (Zig cc Buildroot compatibility)' >&2
	exit 0
fi

if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then
	zig "$driver" --version
	printf '%s\n' 'zig-host compiler compatibility (9.0.0)'
	exit 0
fi

if [ "$#" -eq 1 ] && [ "$1" = "-print-multi-os-directory" ]; then
	printf '%s\n' '.'
	exit 0
fi

# Meson 0.56 recognizes a fixed set of legacy linker version banners.
# Its probe asks the compiler driver to forward --version to the linker.
for arg in "$@"; do
	if [ "$arg" = "-Wl,--version" ]; then
		printf '%s\n' 'GNU ld (Zig ld compatibility) 2.35'
		exit 0
	fi
done

# Queries do not generate code. Zig delegates these to Clang, which does not
# understand Zig's baseline CPU name on x86.
for arg in "$@"; do
	case "$arg" in
		-dumpmachine|-dumpversion|-dumpfullversion|-print-*)
			exec zig "$driver" "$@" ;;
	esac
done

# Keep the native OS and ABI so host headers and libraries remain visible.
# An explicit Linux triple hides crypt.h and libcrypt, causing misleading
# Autoconf failures. Only the CPU must be restricted for portable host caches.
portable_cpu_args=()
case "$(uname -m)" in
	x86_64|aarch64|arm64) portable_cpu_args=(-mcpu=baseline) ;;
esac

# Old libtool releases pass GNU ld scripts as bare compiler-driver inputs.
# GCC recognizes those implicitly, while Zig/Clang requires an explicit -T.
args=()
boundary_section_link=false
input_language=none
operand=
for arg in "$@"; do
	if [ -n "$operand" ]; then
		[ "$operand" != language ] || input_language=$arg
		args+=("$arg")
		operand=
		continue
	fi
	case "$arg" in
		-x) operand=language; args+=("$arg") ;;
		-x*) input_language=${arg#-x}; args+=("$arg") ;;
		-o|-MF|-MT|-MQ|-I|-L|-B|-D|-U|-include|-imacros|-isystem|-iquote|\
		-idirafter|-iprefix|-iwithprefix|-iwithprefixbefore|-isysroot|--sysroot|\
		-target|--target|-arch|--libc|-Xclang|-Xlinker|-Xassembler|-Xpreprocessor)
			operand=value; args+=("$arg") ;;
		-)
			# Meson's untyped stdin probe otherwise bypasses Zig's target
			# parser and sends -mcpu=baseline straight to Clang. Give only
			# this input a language, preserving subsequent file extensions.
			if [ "$input_language" = none ]; then
				args+=(-x "$language" - -x none)
			else
				args+=("$arg")
			fi ;;
		*imagetool.o|*file2alias.o) boundary_section_link=true; args+=("$arg") ;;
		-march=*|-mcpu=*|-mtune=*)
			if [ "${#portable_cpu_args[@]}" -eq 0 ]; then
				args+=("$arg")
			fi ;;
		-Wl,-stats) ;;
		-Wl,-h*)
			args+=("-Wl,-soname" "-Wl,${arg#-Wl,-h}") ;;
		-Wl,--version-script=*)
			args+=("-Wl,--undefined-version" "-Wl,--version-script" "-Wl,${arg#-Wl,--version-script=}") ;;
		-Wl,--version-script)
			args+=("-Wl,--undefined-version" "$arg") ;;
		-Wl,*,-stats,-lc) args+=("${arg%,-stats,-lc}" "-lc") ;;
		-Wl,*,-stats*) args+=("${arg//,-stats/}") ;;
		-Wl,*.lds) args+=("-Wl,-T,${arg#-Wl,}") ;;
		*.lds) args+=("-Wl,-T,$arg") ;;
		*) args+=("$arg") ;;
	esac
done

# Older U-Boot image tools and Linux modpost rely on GNU ld retaining input
# sections that synthesize boundary symbols. Disable section GC only for those
# host-tool links to give LLD the same behavior.
if $boundary_section_link; then
	args+=("-Wl,--no-gc-sections")
fi

exec zig "$driver" "${args[@]}" "${portable_cpu_args[@]}" \
	-Wno-error=date-time \
	-Wno-error=incompatible-function-pointer-types \
	-Wno-error=implicit-function-declaration \
	-Wno-error=bitwise-instead-of-logical
