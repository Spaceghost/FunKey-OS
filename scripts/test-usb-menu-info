#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

retrofe_patch="$repo/FunKey/board/funkey/patches/retrofe/0001-show-ssh-sftp-details-in-usb-menu.patch"
gmenu2x_patch="$repo/FunKey/board/funkey/patches/gmenu2x/0001-show-ssh-sftp-details-in-usb-menu.patch"

authentication_hint='key: /authorized_keys'

fail() {
	printf 'test-usb-menu-info: %s\n' "$*" >&2
	exit 1
}

assert_line() {
	grep -Fqx "$2" "$1" ||
		fail "missing exact line in $1: $2"
}

assert_contains() {
	grep -Fq "$2" "$1" ||
		fail "missing text in $1: $2"
}

assert_absent() {
	if grep -Fq "$2" "$1"; then
		fail "unexpected text in $1: $2"
	fi
}

assert_patch_contract() {
	patch_file=$1
	free_count=

	assert_contains "$patch_file" 'usb_network_enabled = access("/sys/class/net/usb0", F_OK) == 0;'
	assert_contains "$patch_file" '"SSH / SFTP",'
	assert_contains "$patch_file" '"root@192.168.137.2",'
	assert_contains "$patch_file" '"key: /authorized_keys"'
	assert_contains "$patch_file" 'usb_network_enabled && !menu_action && !menu_confirmation'
	assert_contains "$patch_file" 'menu_small_info_font'
	free_count=$(grep -Fc 'SDL_FreeSurface(usb_text_surface);' "$patch_file" || true)
	[ "$free_count" -eq 1 ] ||
		fail "expected one usb_text_surface free in $patch_file, found $free_count"
	assert_absent "$patch_file" 'password: none'
	assert_absent "$patch_file" '/mnt/usbnet'
}

assert_patch_contract "$retrofe_patch"
assert_patch_contract "$gmenu2x_patch"

# GMenu2X used to follow a moving HEAD. Keep it pinned to the source this
# patch was reviewed and built against.
assert_line "$repo/FunKey/package/gmenu2x/gmenu2x.mk" \
	'GMENU2X_VERSION = 8dbc7bfc482262ec0d23c1abad6089aef4bcb6d0'

# Prevent the on-device instructions from drifting away from the actual
# point-to-point network, authentication, and key-provisioning configuration.
for rootfs in FunKey Recovery; do
	case "$rootfs" in
		FunKey) dropbear_init=S50dropbear ;;
		Recovery) dropbear_init=S42dropbear ;;
	esac

	assert_line "$repo/$rootfs/board/funkey/rootfs-overlay/etc/dhcpcd.conf" \
		'static ip_address=192.168.137.2/30'
	assert_line "$repo/$rootfs/board/funkey/rootfs-overlay/etc/dhcpcd.conf" \
		'static routers=192.168.137.1'
	assert_line "$repo/$rootfs/board/funkey/rootfs-overlay/etc/default/dropbear" \
		'DROPBEAR_ARGS="-s -g"'
	assert_line "$repo/$rootfs/board/funkey/rootfs-overlay/etc/default/dropbear" \
		'DROPBEAR_BIND_ADDRESS=192.168.137.2'
	assert_contains "$repo/$rootfs/board/funkey/rootfs-overlay/etc/init.d/$dropbear_init" \
		'cp /mnt/authorized_keys /mnt/FunKey/.ssh/authorized_keys'
	assert_line "$repo/$rootfs/configs/$(printf '%s' "$rootfs" | tr '[:upper:]' '[:lower:]')_defconfig" \
		'BR2_TARGET_GENERIC_ROOT_PASSWD=""'
	assert_line "$repo/$rootfs/configs/$(printf '%s' "$rootfs" | tr '[:upper:]' '[:lower:]')_defconfig" \
		'BR2_PACKAGE_DROPBEAR=y'
	assert_line "$repo/$rootfs/configs/$(printf '%s' "$rootfs" | tr '[:upper:]' '[:lower:]')_defconfig" \
		'BR2_PACKAGE_GESFTPSERVER=y'
done

for display_line in 'SSH / SFTP' 'root@192.168.137.2' "$authentication_hint"; do
	[ "${#display_line}" -le 24 ] ||
		fail "USB menu line exceeds 24 characters: $display_line"
done

printf '%s\n' 'USB menu connection-info tests passed'
