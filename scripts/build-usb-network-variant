#!/bin/bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
base_version=${1:?usage: build-usb-network-variant VERSION}
variant_version="${base_version}-network-only"
profile="$repo/scripts/usb-gadget-network-only"
debugfs_bin=${DEBUGFS:-"$repo/FunKey/output/host/sbin/debugfs"}
e2fsck_bin=${E2FSCK:-"$repo/FunKey/output/host/sbin/e2fsck"}
filesystem_time=${SOURCE_DATE_EPOCH:-$(git -C "$repo" log -1 --format=%ct)}

if [[ ! "$filesystem_time" =~ ^[0-9]+$ ]]; then
	printf 'invalid filesystem timestamp: %s\n' "$filesystem_time" >&2
	exit 2
fi

for tool in "$debugfs_bin" "$e2fsck_bin"; do
	if [[ ! -x "$tool" ]]; then
		printf 'required host tool is missing or not executable: %s\n' "$tool" >&2
		exit 127
	fi
done

declare -a images=(
	"$repo/FunKey/output/images/rootfs.ext2"
	"$repo/Recovery/output/images/rootfs.ext2"
)
backup_dir=$(mktemp -d "$repo/.usb-variant.XXXXXX")

restore_images() {
	local image
	for image in "${images[@]}"; do
		name=$(basename "$(dirname "$(dirname "$(dirname "$image")")")")
		if [[ -e "$backup_dir/$name.rootfs.ext2" ]]; then
			cp --reflink=auto --sparse=always \
				"$backup_dir/$name.rootfs.ext2" "$image"
		fi
	done
	rm -rf "$backup_dir"
}
trap restore_images EXIT

for image in "${images[@]}"; do
	name=$(basename "$(dirname "$(dirname "$(dirname "$image")")")")
	cp --reflink=auto --sparse=always "$image" "$backup_dir/$name.rootfs.ext2"
done

# Both USB profiles share every compiled byte. Mutate a reflinked copy of each
# completed ext4 filesystem instead of asking Buildroot to finalize twice.
for image in "${images[@]}"; do
	commands="$backup_dir/debugfs.commands"
	{
		printf '%s\n' 'cd /etc/default'
		printf '%s\n' 'rm usb-gadget'
		printf 'write %s %s\n' "$profile" 'usb-gadget'
	} > "$commands"
	E2FSPROGS_FAKE_TIME="$filesystem_time" \
		"$debugfs_bin" -w -f "$commands" "$image" >/dev/null 2>&1
	embedded=$("$debugfs_bin" -R 'cat /etc/default/usb-gadget' "$image" 2>/dev/null)
	grep -qx 'USB_NETWORK=always' <<<"$embedded"
	grep -qx 'USB_MASS_STORAGE=0' <<<"$embedded"
	fsck_status=0
	E2FSPROGS_FAKE_TIME="$filesystem_time" E2FSCK_TIME="$filesystem_time" \
		"$e2fsck_bin" -pf "$image" >/dev/null || fsck_status=$?
	if (( fsck_status > 1 )); then
		exit "$fsck_status"
	fi
done

make -C "$repo" -j1 package-image package-update package-checksums \
	FUNKEY_VERSION="$variant_version"
