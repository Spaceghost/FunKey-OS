#!/bin/sh
set -eu

restore=false
if [ "${1:-}" = "--restore" ]; then
	restore=true
	shift
fi

if [ "$#" -ne 1 ]; then
	echo "usage: $0 [--restore] OUTPUT_DIR" >&2
	exit 2
fi

host_bin=$1/host/bin
compiler=$host_bin/arm-linux-gcc
saved=$host_bin/arm-linux-gcc.buildroot
wrapper=$host_bin/arm-linux-zig-cc
cxx_compiler=$host_bin/arm-linux-g++
cxx_saved=$host_bin/arm-linux-g++.buildroot
cxx_wrapper=$host_bin/arm-linux-zig-c++
cc_alias=$host_bin/arm-linux-cc
cxx_alias=$host_bin/arm-linux-c++
target_tools=$host_bin/zig-target-tools

if $restore; then
	if [ -L "$saved" ]; then
		rm -f "$compiler" "$wrapper" "$cxx_compiler" "$cxx_wrapper" "$target_tools/as"
		rmdir "$target_tools" 2>/dev/null || true
		mv "$saved" "$compiler"
		mv "$cxx_saved" "$cxx_compiler"
		ln -sfn toolchain-wrapper "$cc_alias"
		ln -sfn toolchain-wrapper "$cxx_alias"
	fi
	exit 0
fi

if ! command -v zig >/dev/null 2>&1; then
	echo "zig is required in PATH" >&2
	exit 1
fi

if [ ! -x "$host_bin/toolchain-wrapper" ]; then
	echo "Buildroot toolchain is not installed in $1" >&2
	exit 1
fi

if [ ! -L "$saved" ]; then
	mv "$compiler" "$saved"
	mv "$cxx_compiler" "$cxx_saved"
fi

cp "$(dirname "$0")/zig-cc-wrapper" "$wrapper"
chmod +x "$wrapper"
	mkdir -p "$target_tools"
	cp "$(dirname "$0")/zig-as-wrapper" "$target_tools/as"
	chmod +x "$target_tools/as"
ln -sfn "$(basename "$wrapper")" "$cxx_wrapper"
ln -sfn "$(basename "$wrapper")" "$compiler"
ln -sfn "$(basename "$cxx_wrapper")" "$cxx_compiler"
ln -sfn "$(basename "$wrapper")" "$cc_alias"
ln -sfn "$(basename "$cxx_wrapper")" "$cxx_alias"
